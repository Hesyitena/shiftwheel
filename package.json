{
  "name": "shiftwheel",
  "version": "1.0.0",
  "description": "Convert files from a radial wheel: drag a file, tap Shift.",
  "main": "main.js",
  "author": "Shiftwheel",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "predist": "node scripts/make-ico.js",
    "dist": "electron-builder --win",
    "install-local": "node scripts/install-local.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "node test/check.js && node test/hotkeys.test.js && node test/converter.test.js"
  },
  "build": {
    "appId": "com.local.shiftwheel",
    "productName": "Shiftwheel",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "hud.html",
      "converter.js",
      "tools.js",
      "crop.html",
      "hotkeys.js",
      "assets/**"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/uiohook-napi/**"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "afterPack": "scripts/prune-pack.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
