{
  "name": "shiftwheel",
  "version": "1.0.0",
  "description": "Konversi file lewat radial menu: drag file + tahan Shift.",
  "main": "main.js",
  "author": "Shiftwheel",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "predist": "node scripts/make-ico.js",
    "dist": "electron-builder --win",
    "test": "node test/check.js && node test/converter.test.js"
  },
  "build": {
    "appId": "com.local.shiftwheel",
    "productName": "Shiftwheel",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "converter.js",
      "tools.js",
      "assets/**"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/uiohook-napi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
